# Compose reads these. Every line is already the default, so this file is optional.

# jvm-runtime or native-runtime. Selects which Dockerfile stage compose builds.
APP_DOCKER_TARGET=jvm-runtime
APP_IMAGE=webhook-workbench:local
APP_PORT=8080

# Bound to loopback so a local server can reach the container MySQL.
# Change the port if something else already uses 3306.
MYSQL_PORT=3306
MYSQL_DATABASE=webhook_workbench
MYSQL_USER=workbench
MYSQL_PASSWORD=workbench
MYSQL_ROOT_PASSWORD=workbench-root

# Leave empty for no auth. Set one before the instance is reachable off this machine.
WORKBENCH_ACCESS_TOKEN=
WORKBENCH_RETENTION_MAX_EVENTS_PER_INBOX=500

# Bodies larger than this get a 413.
WORKBENCH_MAX_BODY_SIZE=8MB
WORKBENCH_MAX_PAGE_SIZE=500
WORKBENCH_STREAM_HEARTBEAT_INTERVAL=15s
